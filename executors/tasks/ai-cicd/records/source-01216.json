[
  [
    "Q01_sdk",
    [
      "/opt/homebrew/bin/gcloud",
      "version",
      "--format=json"
    ]
  ],
  [
    "Q02_project",
    [
      "/opt/homebrew/bin/gcloud",
      "config",
      "get-value",
      "project"
    ]
  ],
  [
    "Q03_account",
    [
      "/opt/homebrew/bin/gcloud",
      "config",
      "get-value",
      "account"
    ]
  ],
  [
    "Q04_address",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "addresses",
      "describe",
      "<W2_RUN_RESOURCE_PREFIX>-ip",
      "--region=us-central1",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "Q05_inventory",
    [
      "/opt/homebrew/bin/gcloud",
      "asset",
      "search-all-resources",
      "--scope=projects/<CLOUD_PROJECT>",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "Q06_instances",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "instances",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "Q07_disks",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "disks",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "Q08_networks",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "networks",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "Q09_firewalls",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "firewall-rules",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ]
]

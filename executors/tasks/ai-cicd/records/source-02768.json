[
  [
    "Q01_sdk",
    [
      "/opt/homebrew/bin/gcloud",
      "version",
      "--format=json"
    ]
  ],
  [
    "Q02_project",
    [
      "/opt/homebrew/bin/gcloud",
      "config",
      "get-value",
      "project"
    ]
  ],
  [
    "Q03_account",
    [
      "/opt/homebrew/bin/gcloud",
      "config",
      "get-value",
      "account"
    ]
  ],
  [
    "R01_inventory",
    [
      "/opt/homebrew/bin/gcloud",
      "asset",
      "search-all-resources",
      "--scope=projects/<CLOUD_PROJECT>",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R02_instances",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "instances",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R03_disks",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "disks",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R04_addresses",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "addresses",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R05_networks",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "networks",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R06_firewalls",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "firewall-rules",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R07_run",
    [
      "/opt/homebrew/bin/gcloud",
      "run",
      "services",
      "list",
      "--platform=managed",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R08_buckets",
    [
      "/opt/homebrew/bin/gcloud",
      "storage",
      "buckets",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R09_sql",
    [
      "/opt/homebrew/bin/gcloud",
      "sql",
      "instances",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R10_subnets",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "networks",
      "subnets",
      "list",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ],
  [
    "R11_project_ssh",
    [
      "/opt/homebrew/bin/gcloud",
      "compute",
      "project-info",
      "describe",
      "--project=<CLOUD_PROJECT>",
      "--quiet",
      "--format=json"
    ]
  ]
]
